# === LLM (chat completions) ============================================
# 默认按正式评测配置：启用 LLM 时必须提供 OPENAI_API_KEY。
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Qwen3/DeepSeek-R1 等有 thinking 模式，会先输出推理 token 吃掉 max_tokens
# 预算导致返回空。设 false 自动传 enable_thinking=False（非 Qwen API 忽略）。
LLM_ENABLE_THINKING=false
# 单次 LLM 调用最大输出 token。关闭 thinking 时 2048 够用；开启时至少 4096。
LLM_MAX_TOKENS=4096

# === Embeddings（可与 LLM 用不同提供商）=================================
# 留空 EMBEDDING_API_KEY 则回退到 OPENAI_API_KEY / OPENAI_BASE_URL。
# 若 embedding 与 LLM 是不同提供商，填这里。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# === 行为开关 ==========================================================
# 正式评测默认保持 true；若关闭则仅用于显式的本地测试场景。
USE_LLM_ON_ADD=true
USE_LLM_ON_SEARCH=true

# === 鉴权：Memory System Key（供平台访问我方 Add/Search；勿泄露）=========
MEMORY_SYSTEM_KEY=dev-memory-system-key

# === 服务 ==============================================================
HOST=0.0.0.0
PORT=8000

# === 检索 ==============================================================
TOP_K=100
DB_PATH=src/data/memories.db
